{
  "name": "form-personal-health",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "prebuild": "expo prebuild",
    "format": "prettier --write app src tests plugins scripts *.ts *.json docs/*.md README.md",
    "format:check": "prettier --check app src tests plugins scripts *.ts *.json docs/*.md README.md",
    "build:web": "expo export --platform web --output-dir dist-web",
    "test:browser": "node tests/browser-smoke.cjs",
    "postinstall": "node scripts/prepare-dependencies.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "expo": "^54.0.37",
    "expo-background-task": "~1.0.10",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-linking": "~8.0.11",
    "expo-local-authentication": "~17.0.8",
    "expo-notifications": "^0.32.17",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-task-manager": "~14.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-health-connect": "4.1.3",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-web": "~0.21.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "decode-uri-component": "0.5.1",
    "postcss": "8.5.32",
    "image-size": "2.0.4",
    "glob@>=9": "14.0.3",
    "minimatch@>=7": "11.0.5"
  }
}
